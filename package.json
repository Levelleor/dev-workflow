{
  "name": "dev-workflow-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*"],
  "engines": { "node": ">=22" },
  "scripts": {
    "build": "npm run build --workspace @levelleor/agentctl",
    "typecheck": "npm run typecheck --workspace @levelleor/agentctl",
    "test": "npm run test --workspace @levelleor/agentctl && node --test tests/*.test.mjs",
    "smoke": "npm run smoke --workspace @levelleor/agentctl",
    "check": "npm run typecheck && npm run build && npm test && npm run smoke"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "memfs": "^4.17.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
