{
  "name": "@levelleor/agentctl",
  "version": "0.1.0",
  "type": "module",
  "description": "Repository-backed coding-agent harness CLI",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Levelleor/dev-workflow.git",
    "directory": "packages/cli"
  },
  "bin": {
    "agentctl": "./dist/index.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-templates.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "smoke": "node dist/index.js --help && node dist/index.js --version"
  },
  "dependencies": {
    "github-slugger": "^2.0.0",
    "mdast-util-to-string": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-lint-no-undefined-references": "^5.0.2",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "vfile": "^6.0.3",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4"
  }
}
